# .env.example : copy to .env for local runs. On Render, set these in the dashboard instead.
# Never commit the real .env.

# Provider switch: ollama (local) | openai | groq | hf (hosted)
# The JUDGE must be a local small open model (Ollama), from a DIFFERENT family than the agent (self-preference).
LLM_PROVIDER=ollama
AGENT_MODEL=qwen2.5:3b
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.2:3b
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
HF_API_TOKEN=
EMBEDDER=BAAI/bge-small-en-v1.5
RUNS_DIR=./runs
MAX_UPLOAD_MB=25
BUDGET_MAX_LLM_CALLS=400
BUDGET_MAX_SECONDS=1800
# Requests per minute for hosted providers (0 = unlimited)
LLM_RPM=0
# Parallel model calls inside a build stage (agent answers, judge, guard checks, test drafts). 1 = sequential.
# Results are identical either way. For a local Ollama judge, also start Ollama with OLLAMA_NUM_PARALLEL=4,
# otherwise Ollama answers one request at a time and the judge stays the bottleneck.
LLM_CONCURRENCY=4
CORS_ORIGINS=http://localhost:3000
# Optional shared secret the frontend sends as X-API-Key
API_KEY=
